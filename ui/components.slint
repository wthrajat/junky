export global Palette {
    in-out property <bool> dark: true;
    in property <color> bg: dark ? #0b0f14 : #eef1f4;
    in property <color> surface: dark ? #12181f : #ffffff;
    in property <color> raised: dark ? #1a222c : #e6ebf0;
    in property <color> border: dark ? #26313d : #d7dde3;
    in property <color> ink: dark ? #e9eff5 : #16181d;
    in property <color> muted: dark ? #9fadb9 : #4d5a66;
    in property <color> faint: dark ? #79848f : #6d7883;
    in property <color> accent: dark ? #2dd4bf : #007a6e;
    in property <color> accent-ink: dark ? #052e29 : #ffffff;
    in property <color> accent-tint: dark ? #2dd4bf24 : #007a6e1a;
    in property <color> danger: dark ? #f87171 : #c42b1c;
    in property <color> danger-ink: dark ? #300b0b : #ffffff;
    in property <color> amber: dark ? #fbbf24 : #7a5900;
    in property <color> amber-tint: dark ? #fbbf2424 : #7a590017;
    in property <color> track: dark ? #2a343f : #d3d9df;
    in property <color> row-hover: dark ? #ffffff0d : #0000000a;
    in property <color> row-select: dark ? #2dd4bf14 : #007a6e12;
}

export component SectionLabel inherits Text {
    font-size: 11px;
    font-weight: 700;
    color: Palette.muted;
}

export component Badge inherits Rectangle {
    in property <string> text;
    in property <bool> warn;
    width: 88px;
    height: 20px;
    border-radius: 2px;
    background: warn ? Palette.amber-tint : Palette.accent-tint;
    Text {
        text: root.text;
        font-size: 10px;
        font-weight: 700;
        color: warn ? Palette.amber : Palette.accent;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

export component ActionButton inherits Rectangle {
    in property <string> text;
    in property <string> kind;
    in property <bool> compact;
    in property <bool> active: true;
    callback clicked();
    public function focus-self() {
        scope.focus();
    }
    min-width: compact ? 0px : 104px;
    height: compact ? 30px : 36px;
    border-radius: 4px;
    opacity: (active && touch.pressed) ? 0.85 : 1;
    background: !active ? Palette.raised : kind == "danger" ? Palette.danger : kind == "ghost" ? #00000000 : Palette.accent;
    border-width: scope.has-focus ? 2px : kind == "ghost" && active ? 1px : 0px;
    border-color: scope.has-focus ? Palette.accent : Palette.border;
    scope := FocusScope {
        enabled: root.active;
        key-pressed(event) => {
            if event.text == "\n" || event.text == " " {
                root.clicked();
                accept
            } else {
                reject
            }
        }
    }
    touch := TouchArea {
        enabled: root.active;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
    HorizontalLayout {
        padding-left: compact ? 12px : 18px;
        padding-right: compact ? 12px : 18px;
        alignment: center;
        Text {
            text: root.text;
            font-size: compact ? 13px : 14px;
            font-weight: 600;
            color: !root.active ? Palette.faint : root.kind == "danger" ? Palette.danger-ink : root.kind == "ghost" ? Palette.ink : Palette.accent-ink;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
}

export component CustomCheck inherits Rectangle {
    in property <bool> checked;
    in property <bool> active: true;
    width: 18px;
    height: 18px;
    border-radius: 4px;
    border-width: 1px;
    border-color: root.checked && root.active ? Palette.accent : Palette.faint;
    background: !root.checked ? #00000000 : root.active ? Palette.accent : Palette.track;
    opacity: root.active ? 1 : 0.6;
    Text {
        text: "✓";
        font-size: 12px;
        font-weight: 700;
        color: root.active ? Palette.accent-ink : Palette.faint;
        visible: root.checked;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

export component CustomSwitch inherits Rectangle {
    in property <bool> on;
    in property <bool> active: true;
    callback toggled();
    width: 40px;
    height: 20px;
    border-radius: 10px;
    border-width: 1px;
    border-color: root.on && root.active ? Palette.accent : Palette.faint;
    background: root.on && root.active ? Palette.accent : Palette.track;
    opacity: root.active ? 1 : 0.5;
    Rectangle {
        width: 14px;
        height: 14px;
        border-radius: 7px;
        y: 3px;
        x: root.on ? parent.width - self.width - 3px : 3px;
        background: root.on && root.active ? Palette.accent-ink : Palette.muted;
        animate x {
            duration: 150ms;
            easing: ease-out;
        }
    }
    TouchArea {
        mouse-cursor: pointer;
        enabled: root.active;
        clicked => { root.toggled(); }
    }
}

export component SegmentedControl inherits Rectangle {
    in property <[string]> options;
    in property <int> current;
    callback picked(int, string);
    height: 32px;
    border-radius: 6px;
    border-width: 1px;
    border-color: Palette.border;
    background: Palette.surface;
    HorizontalLayout {
        padding: 2px;
        spacing: 2px;
        for opt[i] in root.options: Rectangle {
            border-radius: 4px;
            background: i == root.current ? Palette.accent-tint : #00000000;
            HorizontalLayout {
                padding-left: 10px;
                padding-right: 10px;
                alignment: center;
                Text {
                    text: opt;
                    font-size: 12px;
                    font-weight: i == root.current ? 600 : 400;
                    color: i == root.current ? Palette.ink : Palette.muted;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
            TouchArea {
                mouse-cursor: pointer;
                clicked => { root.picked(i, opt); }
            }
        }
    }
}

export component MiniBar inherits Rectangle {
    in property <float> share;
    height: 3px;
    border-radius: 2px;
    background: Palette.track;
    clip: true;
    Rectangle {
        width: parent.width * clamp(root.share, 0, 1);
        height: 3px;
        border-radius: 2px;
        background: Palette.accent;
    }
}

export component ScanPulse inherits Rectangle {
    in property <bool> running;
    in property <float> phase;
    height: 4px;
    border-radius: 2px;
    background: Palette.track;
    clip: true;
    if running: Rectangle {
        width: 72px;
        height: 4px;
        border-radius: 2px;
        background: Palette.accent;
        x: root.phase * (parent.width + 72px) - 72px;
    }
}

export component CategoryCheckRow inherits Rectangle {
    in property <string> label;
    in property <string> detail;
    in property <bool> checked;
    in property <bool> active: true;
    in property <string> size-text;
    in property <float> share;
    callback toggled();
    border-radius: 4px;
    background: touch.has-hover ? Palette.row-hover : #00000000;
    touch := TouchArea {
        x: 0px;
        y: 0px;
        width: parent.width;
        height: parent.height;
        mouse-cursor: pointer;
        enabled: root.active;
        clicked => { root.toggled(); }
    }
    VerticalLayout {
        padding-left: 8px;
        padding-right: 8px;
        padding-top: 6px;
        padding-bottom: 6px;
        spacing: 5px;
        HorizontalLayout {
            spacing: 10px;
            CustomCheck {
                checked: root.checked;
                active: root.active;
            }
            VerticalLayout {
                spacing: 1px;
                horizontal-stretch: 1;
                Text {
                    text: root.label;
                    font-size: 13px;
                    font-weight: 600;
                    color: Palette.ink;
                }
                Text {
                    text: root.detail;
                    font-size: 11px;
                    color: Palette.muted;
                }
            }
            Text {
                text: root.size-text;
                font-size: 12px;
                font-weight: 600;
                color: Palette.muted;
                vertical-alignment: center;
            }
        }
        MiniBar {
            share: root.share;
        }
    }
}

export component ResultRowView inherits Rectangle {
    in property <bool> selected;
    in property <string> category;
    in property <string> path;
    in property <string> size-text;
    in property <string> risk;
    in property <bool> active: true;
    callback toggled();
    border-radius: 4px;
    background: root.selected ? Palette.row-select : touch.has-hover ? Palette.row-hover : #00000000;
    touch := TouchArea {
        x: 0px;
        y: 0px;
        width: parent.width;
        height: parent.height;
        mouse-cursor: pointer;
        enabled: root.active;
        clicked => { root.toggled(); }
    }
    HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;
        padding-top: 6px;
        padding-bottom: 6px;
        spacing: 10px;
        CustomCheck {
            checked: root.selected;
            active: root.active;
        }
        VerticalLayout {
            spacing: 1px;
            horizontal-stretch: 1;
            Text {
                text: root.category;
                font-size: 12px;
                font-weight: 600;
                color: Palette.ink;
            }
            Text {
                text: root.path;
                font-size: 11px;
                color: Palette.muted;
                overflow: elide;
            }
        }
        Text {
            text: root.size-text;
            font-size: 12px;
            font-weight: 600;
            color: Palette.ink;
            vertical-alignment: center;
        }
        Badge {
            text: root.risk == "aggressive" ? "AGGRESSIVE" : "SAFE";
            warn: root.risk == "aggressive";
        }
    }
}

export component StatBlock inherits VerticalLayout {
    in property <string> label;
    in property <string> value;
    in property <bool> highlight;
    spacing: 2px;
    Text {
        text: root.label;
        font-size: 12px;
        color: Palette.muted;
    }
    Text {
        text: root.value;
        font-size: 26px;
        font-weight: 700;
        color: root.highlight ? Palette.accent : Palette.ink;
    }
}
